---
import { Picture } from 'astro:assets';
import hero from '../assets/photos/seaside-lawn.jpg';

/*
  The welcome. Edit the words here:
  "Hi, I am" / "Aseem Jain" / the line under it.
  The first line of the CV summary ("Product Manager with 6.5+ years building and scaling
  technology-led businesses.") is used in the page description (see Base.astro).
*/
const topics = ['Payments', 'Embedded credit', 'Telematics', 'Data', 'FASTag', 'Healthtech', 'IoT'];
---

<section class="hero relative overflow-hidden pt-14 text-center md:pt-20" aria-labelledby="hero-title">
  <div class="glow" aria-hidden="true"></div>

  <div class="wrap relative">
    <p class="eyebrow fade-up">Product manager · IIM Ahmedabad PGPX '27</p>

    <h1 id="hero-title" class="welcome">
      <span class="line hi"><span>Hi, I am</span></span>
      <span class="line name"><span>Aseem Jain</span></span>
    </h1>

    <p class="lede fade-up" style="--d: 260ms">
      I build products where money, data and customer insights meet.
    </p>

    <div class="fade-up no-print mt-9 flex flex-wrap justify-center gap-3" style="--d: 340ms">
      <a class="btn btn-primary" href="/Aseem_Jain_CV.pdf" download>Download CV</a>
      <a class="btn" href="mailto:x26aseemj@iima.ac.in">Email me</a>
      <a class="btn" href="https://www.linkedin.com/in/aseemjain1504" target="_blank" rel="noopener">LinkedIn ↗</a>
    </div>

    <p class="mt-5 hidden text-sm print:block">₹3,600 Cr annual FASTag volume · 1.5M active vehicles · 72% → 87% payment success · 12-person product pod</p>

    <!-- The portrait in the middle, two numbers on each side, so the layout is symmetric. -->
    <div class="stage print-hide fade-up" style="--d: 420ms">
      <dl class="side side-l">
        <div class="stat-chip" data-reveal>
          <dd class="display"><span data-count data-to="3600" data-prefix="₹" data-suffix=" Cr" data-locale="en-IN">₹3,600 Cr</span></dd>
          <dt>annual FASTag volume owned</dt>
        </div>
        <div class="stat-chip" data-reveal>
          <dd class="display">72% → <span data-count data-from="72" data-to="87" data-suffix="%">87%</span></dd>
          <dt>payment success rate</dt>
        </div>
      </dl>

      <figure class="portrait-wrap">
        <span class="orbit orbit-1" aria-hidden="true"></span>
        <span class="orbit orbit-2" aria-hidden="true"></span>
        <div class="portrait relative aspect-[4/5] overflow-hidden rounded-[2rem] bg-warm">
          <!-- TODO(aseem): replace with a proper headshot if I get one. -->
          <div class="media absolute inset-0" data-parallax>
            <Picture
              src={hero}
              formats={['avif', 'webp']}
              widths={[480, 720, 840]}
              sizes="(min-width: 768px) 352px, 80vw"
              alt="Aseem sitting on a grass lawn by the sea under scattered clouds, smiling in sunglasses"
              class="h-full w-full object-cover"
              style="object-position: 50% 56%"
              loading="eager"
              fetchpriority="high"
            />
            <video
              data-live
              data-autoplay
              data-mp4="/media/live/seaside-lawn.mp4"
              data-webm="/media/live/seaside-lawn.webm"
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
              tabindex="-1"
              class="absolute inset-0 h-full w-full object-cover"
              style="object-position: 50% 56%"
            ></video>
          </div>
        </div>
      </figure>

      <dl class="side side-r">
        <div class="stat-chip" data-reveal>
          <dd class="display"><span data-count data-to="1.5" data-decimals="1" data-suffix="M">1.5M</span></dd>
          <dt>active vehicles</dt>
        </div>
        <div class="stat-chip" data-reveal>
          <dd class="display"><span data-count data-to="12">12</span>-person</dd>
          <dt>product pod led</dt>
        </div>
      </dl>
    </div>

    <ul class="fade-up print-hide topics" style="--d: 500ms" aria-label="Areas I work in">
      {topics.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</section>

<style>
  .glow {
    position: absolute; left: 50%; top: -12rem; width: min(110vw, 62rem); aspect-ratio: 1; translate: -50% 0; pointer-events: none;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 17%, transparent), transparent 64%);
    animation: breathe 14s ease-in-out infinite alternate;
  }
  @keyframes breathe { to { transform: scale(1.1); opacity: 0.8; } }

  .eyebrow { display: block; margin-bottom: 1.25rem; }

  /* The welcome: a small italic greeting, then the name as large as the screen allows. */
  .welcome { font-family: var(--font-serif); font-weight: 400; display: block; }
  .line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .line > span { display: inline-block; animation: rise 760ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .hi { font-style: italic; font-size: clamp(1.7rem, 3.8vw, 2.9rem); line-height: 1.2; color: var(--accent-ink); letter-spacing: -0.01em; }
  .name { font-size: min(22vw, 5.6rem); line-height: 0.95; letter-spacing: -0.04em; }
  @media (min-width: 640px) { .name { font-size: clamp(4.1rem, 16.4vw, 14rem); } }
  .name > span { animation-delay: 120ms; }
  @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }

  .lede { max-width: 36rem; margin: 1.75rem auto 0; font-size: clamp(1.15rem, 1.7vw, 1.45rem); line-height: 1.5; color: var(--muted); text-wrap: balance; }

  .stage { display: grid; grid-template-columns: 1fr 1fr; grid-template-areas: 'p p' 'l r'; gap: 1.25rem 0.9rem; margin: 4rem auto 0; max-width: 24rem; align-items: stretch; }
  .portrait-wrap { grid-area: p; position: relative; width: min(100%, 22rem); margin-inline: auto; }
  .side { display: contents; margin: 0; }
  .side-l { grid-area: l; } .side-r { grid-area: r; }
  .portrait { position: relative; z-index: 1; }
  .media { transform: scale(1.12); }
  .media :global(video) { opacity: 0; transition: opacity 700ms ease; }
  .media :global(video.is-playing) { opacity: 1; }

  .orbit { position: absolute; left: 50%; top: 50%; border-radius: 50%; translate: -50% -50%; pointer-events: none; border: 1px solid rgba(143, 211, 189, 0.30); }
  .orbit-1 { width: 118%; aspect-ratio: 1; }
  .orbit-2 { width: 142%; aspect-ratio: 1; border-color: rgba(143, 211, 189, 0.14); }

  .stat-chip { background: var(--surface-2); border: 1px solid var(--line); border-radius: 1.1rem; padding: 0.85rem 1rem; text-align: left; }
  .stat-chip dd { font-size: 1.75rem; line-height: 1.05; margin: 0; color: var(--ink); }
  .stat-chip dt { font-size: 0.78rem; color: var(--muted); margin-top: 0.25rem; line-height: 1.3; }

  @media (min-width: 900px) {
    .stage { max-width: none; grid-template-columns: 1fr auto 1fr; grid-template-areas: 'l p r'; gap: 0 clamp(2rem, 5vw, 5rem); align-items: center; }
    .portrait-wrap { width: clamp(17rem, 25vw, 22rem); }
    .side { display: grid; gap: 1.25rem; }
    .side-l { justify-items: end; } .side-r { justify-items: start; }
    .stat-chip { width: 13.5rem; animation: bob 7s ease-in-out infinite alternate; }
    .side-r .stat-chip { animation-delay: -3s; }
    .side .stat-chip:nth-child(2) { animation-delay: -5s; }
  }
  @keyframes bob { to { transform: translateY(-7px); } }

  .topics { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin: 3.25rem auto 0; max-width: 40rem; padding-bottom: 6.5rem; }
  .topics li { font-size: 0.875rem; padding: 0.4rem 0.95rem; border-radius: 999px; color: var(--ink); background: color-mix(in srgb, var(--accent) 12%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent); }

  @media (prefers-reduced-motion: reduce) { .glow, .stat-chip { animation: none; } .media { transform: none; } }
</style>

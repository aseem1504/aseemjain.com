---
import { Picture } from 'astro:assets';
import hero from '../assets/photos/wide-lawn.jpg';

/*
  Headline options (swap by editing the h1 lines below):
  A (live): I build products where money, data and trucks meet.
  B: Engineer by training. Product manager by choice.
  C: 6.5 years making payments, credit and data work for India's truckers.
*/
const topics = ['Payments', 'Embedded credit', 'Telematics', 'Data', 'FASTag', 'Healthtech', 'IoT'];
---

<section class="relative overflow-hidden pt-10 md:pt-16" aria-labelledby="hero-title">
  <div class="blob" aria-hidden="true"></div>

  <div class="wrap relative grid items-center gap-12 pb-16 md:grid-cols-12 md:gap-8 md:pb-24">
    <div class="md:col-span-8">
      <p class="eyebrow fade-up mb-5">Product manager · IIM Ahmedabad PGPX '27</p>

      <h1 id="hero-title" class="display text-[clamp(3rem,7.6vw,6rem)]">
        <span class="line"><span>I build products</span></span>
        <span class="line"><span>where <em class="text-accent-ink">money, data</em></span></span>
        <span class="line"><span>and trucks meet.</span></span>
      </h1>

      <p class="fade-up mt-7 max-w-xl text-lg text-muted md:text-xl" style="--d: 260ms">
        Product manager. 6.5+ years across fintech, telematics and healthtech. Now at IIM Ahmedabad (PGPX '27).
      </p>

      <div class="fade-up no-print mt-9 flex flex-wrap gap-3" style="--d: 340ms">
        <a class="btn btn-primary" href="/Aseem_Jain_CV.pdf" download>Download CV</a>
        <a class="btn" href="mailto:x26aseemj@iima.ac.in">Email me</a>
        <a class="btn" href="https://www.linkedin.com/in/aseemjain1504" target="_blank" rel="noopener">LinkedIn ↗</a>
      </div>
    </div>

    <figure class="fade-up print-hide md:col-span-4" style="--d: 120ms">
      <div class="relative ml-auto w-full max-w-md">
        <span class="sun-disc" aria-hidden="true"></span>
        <div class="portrait relative aspect-[4/5] overflow-hidden rounded-[2rem] bg-warm">
          <!-- TODO(aseem): replace with a proper headshot if I get one. -->
          <Picture
            src={hero}
            formats={['avif', 'webp']}
            widths={[480, 720, 960]}
            sizes="(min-width: 768px) 420px, 90vw"
            alt="Aseem sitting cross-legged on a huge green lawn, with long lines of trees on both sides and a big blue sky above"
            class="h-full w-full object-cover"
            style="object-position: 55% 50%"
            loading="eager"
            fetchpriority="high"
            data-parallax
          />
        </div>
      </div>
    </figure>
  </div>

  <div class="bg-accent text-on-accent">
    <dl class="wrap grid grid-cols-2 md:grid-cols-4" data-reveal>
      <div class="py-7 pr-4 md:py-9">
        <dd class="display text-[clamp(2.2rem,5vw,4rem)]"><span data-count data-to="3600" data-prefix="₹" data-suffix=" Cr" data-locale="en-IN">₹3,600 Cr</span></dd>
        <dt class="mt-1 text-sm">annual FASTag volume owned</dt>
      </div>
      <div class="py-7 pr-4 md:py-9">
        <dd class="display text-[clamp(2.2rem,5vw,4rem)]"><span data-count data-to="1.5" data-decimals="1" data-suffix="M">1.5M</span></dd>
        <dt class="mt-1 text-sm">active vehicles</dt>
      </div>
      <div class="py-7 pr-4 md:py-9">
        <dd class="display text-[clamp(2.2rem,5vw,4rem)]">72% → <span data-count data-from="72" data-to="87" data-suffix="%">87%</span></dd>
        <dt class="mt-1 text-sm">payment success rate</dt>
      </div>
      <div class="py-7 pr-4 md:py-9">
        <dd class="display text-[clamp(2.2rem,5vw,4rem)]"><span data-count data-to="12">12</span>-person</dd>
        <dt class="mt-1 text-sm">product pod led</dt>
      </div>
    </dl>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1, 2, 3].map(() => topics.map((t) => <span>{t}</span>))}
    </div>
  </div>
</section>

<style>
  .line { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .line > span { display: inline-block; animation: rise 640ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .line:nth-child(2) > span { animation-delay: 90ms; }
  .line:nth-child(3) > span { animation-delay: 180ms; }
  @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
  h1 em { font-style: italic; }

  .blob {
    position: absolute; left: -18%; top: -22%; width: 64vw; max-width: 820px; aspect-ratio: 1; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, color-mix(in srgb, var(--sun) 30%, transparent), transparent 68%);
    animation: drift 18s ease-in-out infinite alternate;
  }
  @keyframes drift { to { transform: translate(6%, 8%) scale(1.08); } }

  .sun-disc {
    position: absolute; right: -14%; top: -9%; width: 80%; aspect-ratio: 1; border-radius: 50%; background: var(--sun);
    animation: float 9s ease-in-out infinite alternate;
  }
  @keyframes float { to { transform: translate(-3%, 4%); } }
  .portrait img { transform: scale(1.12); }
  @media (prefers-reduced-motion: reduce) { .blob, .sun-disc { animation: none; } .portrait img { transform: none; } }
</style>

---
import { Picture } from 'astro:assets';
import hero from '../assets/photos/hero.jpg';

/*
  Headline options (swap by editing the h1 lines below):
  A (live): I build products where money, data and trucks meet.
  B: Engineer by training. Product manager by choice.
  C: 6.5 years making payments, credit and data work for India's truckers.
*/
---

<section class="relative overflow-hidden pb-16 pt-10 md:pb-24 md:pt-16" aria-labelledby="hero-title">
  <div class="wrap grid items-center gap-10 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-7">
      <p class="eyebrow fade-up mb-5">Product manager · IIM Ahmedabad PGPX '27</p>

      <h1 id="hero-title" class="display text-[clamp(2.7rem,7.2vw,5.6rem)]">
        <span class="line"><span>I build products</span></span>
        <span class="line"><span>where <em class="text-accent-ink">money, data</em></span></span>
        <span class="line"><span>and trucks meet.</span></span>
      </h1>

      <p class="fade-up mt-6 max-w-xl text-lg text-muted" style="--d: 260ms">
        Product manager. 6.5+ years across fintech, telematics and healthtech. Now at IIM Ahmedabad (PGPX '27).
      </p>

      <div class="fade-up no-print mt-8 flex flex-wrap gap-3" style="--d: 340ms">
        <a class="btn btn-primary" href="/Aseem_Jain_CV.pdf" download>Download CV</a>
        <a class="btn" href="mailto:x26aseemj@iima.ac.in">Email me</a>
        <a class="btn" href="https://www.linkedin.com/in/aseemjain1504" target="_blank" rel="noopener">LinkedIn ↗</a>
      </div>
    </div>

    <figure class="fade-up print-hide md:col-span-5" style="--d: 120ms">
      <div class="portrait relative ml-auto aspect-[4/5] w-full max-w-md overflow-hidden rounded-[1.75rem] border border-line bg-warm">
        <!-- TODO(aseem): replace with a proper headshot if I get one. -->
        <Picture
          src={hero}
          formats={['avif', 'webp']}
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 420px, 90vw"
          alt="Aseem Jain sitting on a riverside wall at night, in a cream cap and white linen shirt, looking off to the side"
          class="h-full w-full object-cover"
          style="object-position: 54% 50%"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </figure>
  </div>

  <div class="wrap mt-12 md:mt-16">
    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-4" data-reveal>
      <div class="bg-card p-5 md:p-6">
        <dd class="display text-4xl md:text-5xl">
          <span data-count data-to="3600" data-prefix="₹" data-suffix=" Cr" data-locale="en-IN">₹3,600 Cr</span>
        </dd>
        <dt class="mt-1 text-sm text-muted">annual FASTag volume owned</dt>
      </div>
      <div class="bg-card p-5 md:p-6">
        <dd class="display text-4xl md:text-5xl">
          <span data-count data-to="1.5" data-decimals="1" data-suffix="M">1.5M</span>
        </dd>
        <dt class="mt-1 text-sm text-muted">active vehicles</dt>
      </div>
      <div class="bg-card p-5 md:p-6">
        <dd class="display text-4xl md:text-5xl">72% → <span data-count data-from="72" data-to="87" data-suffix="%">87%</span></dd>
        <dt class="mt-1 text-sm text-muted">payment success rate</dt>
      </div>
      <div class="bg-card p-5 md:p-6">
        <dd class="display text-4xl md:text-5xl"><span data-count data-to="12">12</span>-person</dd>
        <dt class="mt-1 text-sm text-muted">product pod led</dt>
      </div>
    </dl>
  </div>
</section>

<style>
  .line { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .line > span { display: inline-block; animation: rise 640ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .line:nth-child(2) > span { animation-delay: 90ms; }
  .line:nth-child(3) > span { animation-delay: 180ms; }
  @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
  h1 em { font-style: italic; }
</style>

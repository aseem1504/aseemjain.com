---
import credentials from '../content/credentials.json';

// Logos: drop a file named after the id into src/assets/logos/ (for example iima.svg or kpmg.png)
// and it appears here. Until then each tile shows a monogram.
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*.{svg,png,webp,jpg,jpeg}', { eager: true });
const logoFor = (id: string) => {
  const key = Object.keys(logos).find((k) => k.split('/').pop()!.replace(/\.[a-z]+$/i, '') === id);
  return key ? logos[key].default : undefined;
};

const learn = credentials.filter((c) => c.group === 'learn');
const work = credentials.filter((c) => c.group === 'work');
---

<section id="credentials" class="sheet bg-teal-wash pb-24 pt-20 md:pb-32 md:pt-28" aria-labelledby="cred-title">
  <div class="wrap">
    <p class="eyebrow mb-3" data-reveal>Where I learned</p>
    <h2 id="cred-title" class="display text-[clamp(2.6rem,6.5vw,5.5rem)]" data-split>Schools, certifications and teams.</h2>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {learn.map((c) => {
        const logo = logoFor(c.id);
        return (
          <li class="tile" data-rise>
            <div class="mark">
              {logo ? <img src={logo.src} width={logo.width} height={logo.height} alt={`${c.name} logo`} loading="lazy" /> : <span class="mono" aria-hidden="true">{c.mono}</span>}
            </div>
            <h3 class="display text-2xl leading-tight md:text-[1.7rem]">{c.name}</h3>
            <p class="mt-1.5 text-[0.95rem] leading-snug text-muted">{c.line}</p>
            {c.when && <p class="when">{c.when}</p>}
          </li>
        );
      })}
    </ul>

    <p class="eyebrow print-hide mb-4 mt-14" data-reveal>Where I built</p>
    <ul class="print-hide grid gap-5 sm:grid-cols-2">
      {work.map((c) => {
        const logo = logoFor(c.id);
        return (
          <li class="tile tile-work" data-rise>
            <div class="mark">
              {logo ? <img src={logo.src} width={logo.width} height={logo.height} alt={`${c.name} logo`} loading="lazy" /> : <span class="mono" aria-hidden="true">{c.mono}</span>}
            </div>
            <div>
              <h3 class="display text-2xl leading-tight md:text-[1.7rem]">{c.name}</h3>
              <p class="mt-1.5 text-[0.95rem] leading-snug text-muted">{c.line}</p>
              {c.when && <p class="when">{c.when}</p>}
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .tile {
    background: var(--card); border-radius: 1.75rem; padding: 1.6rem; display: flex; flex-direction: column;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 6%, transparent), 0 18px 40px -26px rgb(0 0 0 / 0.28);
    transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 320ms;
  }
  .tile:hover { transform: translateY(-5px); box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 6%, transparent), 0 26px 50px -24px rgb(0 0 0 / 0.34); }
  .tile-work { flex-direction: row; align-items: center; gap: 1.25rem; }
  .tile-work .mark { margin-bottom: 0; flex: none; }
  .mark {
    height: 4.6rem; width: 100%; max-width: 15rem; margin-bottom: 1.2rem; display: flex; align-items: center;
    transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tile-work .mark { width: auto; min-width: 4.6rem; max-width: 9rem; }
  .tile:hover .mark { transform: scale(1.05); }
  .mark img { max-height: 100%; max-width: 100%; width: auto; object-fit: contain; }
  .mono {
    display: inline-grid; place-items: center; min-width: 4.6rem; height: 4.6rem; padding-inline: 0.9rem; border-radius: 1.3rem;
    font-family: var(--font-serif); font-size: 1.5rem; letter-spacing: 0.02em; color: var(--on-accent);
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 80%, white), var(--accent));
  }
  .tile:nth-child(3n + 2) .mono { background: linear-gradient(135deg, color-mix(in srgb, var(--sun) 70%, white), var(--sun)); }
  .when {
    margin-top: auto; padding-top: 1rem; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-ink);
  }
  .tile-work .when { margin-top: 0.5rem; padding-top: 0; }
</style>

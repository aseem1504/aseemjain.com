---
// Teental is a 16-beat tabla cycle. Heights follow the feel of the bols: open strokes (Dha, Dhin) tall,
// closed strokes (Tin, Ta) short, and the clap on beat 1 and 9 tallest.
const bars = [10, 7, 7, 9, 10, 7, 7, 9, 10, 4, 4, 5, 5, 7, 7, 9];
---

<footer class="border-t border-line py-10">
  <div class="wrap flex flex-col items-center gap-6 md:flex-row md:justify-between">
    <p class="text-sm text-muted">© {new Date().getFullYear()} Aseem Jain</p>

    <svg class="wave h-10 w-48 text-accent" viewBox="0 0 160 40" fill="currentColor" aria-hidden="true">
      {bars.map((h, i) => (
        <rect class="bar" x={i * 10 + 2} y={20 - h * 1.8} width="5" height={h * 3.6} rx="2.5" style={`animation-delay:${i * 90}ms`} />
      ))}
    </svg>

    <p class="text-sm text-muted">Built by hand. Rhythm: teental, 16 beats.</p>
  </div>
</footer>

<style>
  .bar { transform-box: fill-box; transform-origin: center; animation: pulse 1.8s ease-in-out infinite; opacity: 0.9; }
  @keyframes pulse { 0%, 100% { transform: scaleY(0.55); } 50% { transform: scaleY(1); } }
</style>

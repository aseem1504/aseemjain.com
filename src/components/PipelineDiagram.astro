---
interface Props {
  steps: { label: string; sub?: string }[];
  name: string;
}
const { steps, name } = Astro.props;
const n = steps.length;

// Wide layout (md and up): boxes in a row. Dots travel along each connector on hover.
const W = 124, H = 64, GAP = 40;
const wideW = n * W + (n - 1) * GAP + 4;
const wideH = H + 6;

// Narrow layout: boxes stacked.
const TW = 300, TH = 56, TGAP = 30;
const tallH = n * TH + (n - 1) * TGAP + 4;

const summary = `${name} pipeline: ${steps.map((s) => s.label).join(', then ')}.`;
---

<figure class="pipeline" data-pipeline>
  <!-- Wide -->
  <svg class="hidden w-full md:block" viewBox={`0 0 ${wideW} ${wideH}`} role="img" aria-label={summary}>
    <title>{summary}</title>
    {steps.map((s, i) => {
      const x = 2 + i * (W + GAP);
      return (
        <g>
          <rect x={x} y="3" width={W} height={H} rx="10" class="box" />
          <text x={x + W / 2} y="29" text-anchor="middle" class="lbl">{s.label}</text>
          {s.sub && <text x={x + W / 2} y="47" text-anchor="middle" class="sub">{s.sub}</text>}
          {i < n - 1 && (
            <g>
              <line x1={x + W + 4} y1={3 + H / 2} x2={x + W + GAP - 4} y2={3 + H / 2} class="conn" />
              <path d={`M${x + W + GAP - 9} ${3 + H / 2 - 4} l5 4 l-5 4`} class="arrow" />
              <circle cx={x + W + 4} cy={3 + H / 2} r="3" class="dot dot-x" style={`animation-delay:${i * 180}ms`} />
            </g>
          )}
        </g>
      );
    })}
  </svg>

  <!-- Narrow -->
  <svg class="mx-auto block w-full max-w-sm md:hidden" viewBox={`0 0 ${TW + 4} ${tallH}`} role="img" aria-label={summary}>
    <title>{summary}</title>
    {steps.map((s, i) => {
      const y = 2 + i * (TH + TGAP);
      return (
        <g>
          <rect x="2" y={y} width={TW} height={TH} rx="10" class="box" />
          <text x="18" y={y + 24} class="lbl lbl-l">{s.label}</text>
          {s.sub && <text x="18" y={y + 42} class="sub sub-l">{s.sub}</text>}
          {i < n - 1 && (
            <g>
              <line x1={2 + TW / 2} y1={y + TH + 3} x2={2 + TW / 2} y2={y + TH + TGAP - 3} class="conn" />
              <circle cx={2 + TW / 2} cy={y + TH + 3} r="3" class="dot dot-y" style={`animation-delay:${i * 180}ms`} />
            </g>
          )}
        </g>
      );
    })}
  </svg>
</figure>

<style>
  .box { fill: var(--paper); stroke: var(--line); stroke-width: 1; transition: stroke 200ms; }
  [data-pipeline]:hover .box { stroke: var(--accent); }
  .lbl { font: 600 13px var(--font-sans); fill: var(--ink); }
  .sub { font: 400 11px var(--font-sans); fill: var(--muted); }
  .lbl-l, .sub-l { text-anchor: start; }
  .conn { stroke: var(--line); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .arrow { fill: none; stroke: var(--muted); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .dot { fill: var(--accent); opacity: 0; }
  @keyframes flow-x { 0% { transform: translateX(0); opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translateX(32px); opacity: 0; } }
  @keyframes flow-y { 0% { transform: translateY(0); opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translateY(24px); opacity: 0; } }
  .dot-x { animation: flow-x 1.1s ease-in-out infinite; animation-play-state: paused; }
  .dot-y { animation: flow-y 1.1s ease-in-out infinite; animation-play-state: paused; }
  /* Move on hover or keyboard focus; on touch screens (no hover) keep it gently moving. */
  :global(.project-card):hover .dot-x, :global(.project-card):focus-within .dot-x,
  :global(.project-card):hover .dot-y, :global(.project-card):focus-within .dot-y { animation-play-state: running; }
  @media (hover: none) { .dot-x, .dot-y { animation-play-state: running; } }
  @media (prefers-reduced-motion: reduce) { .dot { display: none; } }
</style>

---
interface Row { label: string; before: number; after: number; max?: number; note?: string }
interface Props { rows: Row[]; unit?: string; beforeLabel?: string; afterLabel?: string }
const { rows, unit = '', beforeLabel = 'Before', afterLabel = 'After' } = Astro.props;

// A row with any decimal shows both values to two places, so 1 reads as 1.00 next to 0.72.
const fmt = (v: number, r: Row) => (unit === '%' ? `${v}%` : (!Number.isInteger(r.before) || !Number.isInteger(r.after) || r.max === 1) ? v.toFixed(2) : String(v));
const scale = (r: Row) => r.max ?? (unit === '%' ? 100 : Math.max(r.before, r.after));
const w = (v: number, r: Row) => `${Math.max(2, Math.min(100, (v / scale(r)) * 100)).toFixed(1)}%`;
---

<div class="compare" data-bars>
  <div class="mb-4 flex flex-wrap gap-x-5 gap-y-1 text-xs text-muted">
    <span class="inline-flex items-center gap-2"><i class="sw sw-before"></i>{beforeLabel}</span>
    <span class="inline-flex items-center gap-2"><i class="sw sw-after"></i>{afterLabel}</span>
  </div>
  <ul class="grid gap-5">
    {rows.map((r) => (
      <li>
        <p class="mb-2 text-sm font-medium">{r.label}</p>
        <div class="grid gap-1.5">
          <div class="flex items-center gap-3">
            <div class="track"><span class="fill fill-before" style={`--w:${w(r.before, r)}`}></span></div>
            <span class="val text-muted">{fmt(r.before, r)}</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="track"><span class="fill fill-after" style={`--w:${w(r.after, r)}`}></span></div>
            <span class="val font-semibold text-accent-ink">{fmt(r.after, r)}</span>
          </div>
        </div>
        {r.note && <p class="mt-1 text-xs text-muted">{r.note}</p>}
      </li>
    ))}
  </ul>
</div>

<style>
  .sw { display: inline-block; width: 12px; height: 12px; border-radius: 3px; }
  .sw-before { background: color-mix(in srgb, var(--ink) 22%, var(--paper)); }
  .sw-after { background: var(--accent); }
  .track { flex: 1; height: 12px; border-radius: 6px; background: color-mix(in srgb, var(--ink) 6%, transparent); overflow: hidden; }
  .fill { display: block; height: 100%; width: var(--w); border-radius: 6px; transform-origin: left; }
  .fill-before { background: color-mix(in srgb, var(--ink) 22%, var(--paper)); }
  .fill-after { background: var(--accent); }
  .val { width: 3.2rem; text-align: right; font-variant-numeric: tabular-nums; font-size: 0.9rem; }
  :global(html.js) [data-bars] .fill { transform: scaleX(0); transition: transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  :global(html.js .is-in) [data-bars] .fill, :global(html.js) [data-bars]:global(.is-in) .fill { transform: none; }
  :global(html.js .is-in) [data-bars] .fill-after { transition-delay: 200ms; }
  @media (prefers-reduced-motion: reduce) { :global(html.js) [data-bars] .fill { transform: none; } }
</style>

---
import type { CollectionEntry } from 'astro:content';
import PipelineDiagram from './PipelineDiagram.astro';
import ResultVisual from './ResultVisual.astro';

interface Props { project: CollectionEntry<'projects'>; index: number }
const { project, index } = Astro.props;
const d = project.data;
const num = String(index + 1).padStart(2, '0');
const repoUrl = d.repo ? `https://github.com/aseem1504/${d.repo}` : undefined;
---

{d.inProgress ? (
  <article class="rounded-3xl border border-dashed border-line p-6 md:p-8" data-reveal>
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
      <span class="text-sm tabular-nums text-muted">{num}</span>
      <h3 class="display text-2xl md:text-3xl">{d.title}</h3>
      <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">In progress</span>
    </div>
    <p class="mt-3 max-w-xl text-muted">Building now. Coming soon.</p>
    <div class="mt-4 flex flex-wrap gap-2">{d.tags.map((t) => <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{t}</span>)}</div>
    {/* TODO(aseem): add the repo link when it is ready (repo: <name> in src/content/projects/ai-agent-in-progress.md). */}
  </article>
) : (
  <article class="project-card border-t-2 border-ink pt-8" data-reveal>
    <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
      <div class="flex items-baseline gap-4">
        <span class="text-sm tabular-nums text-muted">{num}</span>
        <h3 class="display text-2xl md:text-4xl">{d.title}</h3>
      </div>
      <ul class="flex flex-wrap gap-2">{d.tags.map((t) => <li class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{t}</li>)}</ul>
    </header>

    <div class="mt-7 grid gap-8 md:grid-cols-2 md:gap-10">
      <dl class="grid content-start gap-4 text-[0.97rem]">
        <div><dt class="eyebrow mb-1">The problem</dt><dd class="text-ink/85">{d.problem}</dd></div>
        <div><dt class="eyebrow mb-1">What I built</dt><dd class="text-ink/85">{d.built}</dd></div>
        <div><dt class="eyebrow mb-1">The result</dt><dd class="font-medium">{d.result}</dd></div>
      </dl>
      {d.visual && <ResultVisual visual={d.visual} />}
    </div>

    <div class="mt-8 border-t border-line pt-6">
      <p class="mb-3 text-xs text-muted">How it works. Hover to see the flow.</p>
      <PipelineDiagram steps={d.steps} name={d.title} />
    </div>

    <footer class="mt-6 flex flex-wrap items-center gap-3">
      <a class="btn btn-primary" href={`/projects/${project.id}`}>Read the walkthrough</a>
      {repoUrl && <a class="btn" href={repoUrl} target="_blank" rel="noopener">View code ↗</a>}
    </footer>
  </article>
)}

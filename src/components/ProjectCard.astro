---
import type { CollectionEntry } from 'astro:content';
import ResultVisual from './ResultVisual.astro';

interface Props { project: CollectionEntry<'projects'>; index: number }
const { project, index } = Astro.props;
const d = project.data;
const num = String(index + 1).padStart(2, '0');
const repoUrl = d.repo ? `https://github.com/aseem1504/${d.repo}` : undefined;
---

{d.inProgress ? (
  <article class="flex flex-col rounded-[1.75rem] border border-dashed border-ink/30 p-6" data-reveal>
    <div class="flex items-baseline gap-3">
      <span class="text-sm tabular-nums text-muted">{num}</span>
      <h3 class="display text-2xl md:text-[1.9rem]">{d.title}</h3>
    </div>
    <p class="mt-3 text-muted">Building now. Coming soon.</p>
    <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted">{d.tags.map((t) => <li>{t}</li>)}</ul>
    {/* TODO(aseem): add the repo link when it is ready (repo: <name> in src/content/projects/ai-agent-in-progress.md). */}
  </article>
) : (
  <article class="project-card pc" data-reveal>
    <div class="flex items-baseline gap-3">
      <span class="text-sm tabular-nums text-muted">{num}</span>
      <h3 class="display text-2xl md:text-[1.9rem]">{d.title}</h3>
    </div>
    <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted">{d.tags.map((t) => <li>{t}</li>)}</ul>

    <p class="mt-4 font-medium leading-snug">{d.result}</p>
    <p class="mt-2 text-[0.9rem] leading-relaxed text-muted"><b class="font-semibold text-ink">Problem.</b>{' '}{d.problem}{' '}<b class="font-semibold text-ink">Built.</b>{' '}{d.built}</p>

    {d.visual && <div class="mt-5"><ResultVisual visual={d.visual} compact /></div>}

    <ol class="mini-flow mt-5" aria-label={`How ${d.title} works`}>
      {d.steps.map((s, i) => <li style={`--i:${i}`}>{s.label}</li>)}
    </ol>

    <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      <a class="font-semibold text-accent-ink underline decoration-ink/20 underline-offset-4 hover:decoration-accent-ink" href={`/projects/${project.id}`}>Walkthrough →</a>
      {repoUrl && <a class="font-semibold underline decoration-ink/20 underline-offset-4 hover:decoration-ink" href={repoUrl} target="_blank" rel="noopener">View code ↗</a>}
    </div>
  </article>
)}

<style>
  .pc { display: flex; flex-direction: column; border-top: 1px solid color-mix(in srgb, var(--accent) 50%, transparent); padding-top: 1.25rem; }
  .mini-flow { display: flex; flex-wrap: wrap; gap: 0.3rem 0.15rem; font-size: 0.72rem; }
  .mini-flow li { display: inline-flex; align-items: center; padding: 0.22rem 0.6rem; border-radius: 999px; background: color-mix(in srgb, var(--accent) 34%, transparent); color: var(--ink); }
  .mini-flow li:not(:last-child)::after { content: "›"; margin-left: 0.55rem; margin-right: -0.2rem; color: var(--muted); font-size: 0.9rem; }
  .mini-flow li:not(:last-child) { padding-right: 0.3rem; background: none; }
  .mini-flow li:not(:last-child) { background: color-mix(in srgb, var(--accent) 34%, transparent); border-radius: 999px 0 0 999px; }
  /* On hover the steps light up in order, like the data moving through. */
  @keyframes glow { 0%, 100% { background-color: color-mix(in srgb, var(--accent) 34%, transparent); } 40% { background-color: var(--accent); } }
  .project-card:hover .mini-flow li { animation: glow 1.4s ease-in-out infinite; animation-delay: calc(var(--i) * 140ms); }
  @media (hover: none), (prefers-reduced-motion: reduce) { .project-card:hover .mini-flow li { animation: none; } }
</style>

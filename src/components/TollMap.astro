---
import toll from '../content/project-data/toll.json';

// Project lat/lon onto a flat canvas, correcting longitude for latitude.
const PAD = 30;
const W = 340;
const lats = [...toll.plazas.map((p) => p.lat), ...toll.trail.map((t) => t[0])];
const lons = [...toll.plazas.map((p) => p.lon), ...toll.trail.map((t) => t[1])];
const latMin = Math.min(...lats), latMax = Math.max(...lats);
const lonMin = Math.min(...lons), lonMax = Math.max(...lons);
const k = Math.cos((((latMin + latMax) / 2) * Math.PI) / 180);
const scale = (W - PAD * 2) / ((lonMax - lonMin) * k);
const H = Math.round((latMax - latMin) * scale + PAD * 2);
const px = (lon: number) => PAD + (lon - lonMin) * k * scale;
const py = (lat: number) => PAD + (latMax - lat) * scale;

const trailPath = toll.trail.map((t, i) => `${i ? 'L' : 'M'}${px(t[1]).toFixed(1)} ${py(t[0]).toFixed(1)}`).join(' ');
const plazas = [...toll.plazas].sort((a, b) => a.lat - b.lat).map((p, i) => ({ ...p, n: i + 1, x: px(p.lon), y: py(p.lat), missed: toll.missedByGrid.includes(p.code) }));
const maxErr = Math.max(...plazas.map((p) => p.errM));
---

<div class="grid items-start gap-6 md:grid-cols-5" data-toll-map>
  <svg class="mx-auto w-full max-w-[340px] md:col-span-3" viewBox={`0 0 ${W} ${H}`} role="img"
    aria-label={`Map of a fictional highway with ${plazas.length} toll plazas. A sample truck's GPS trail runs along it. The original grid matching missed ${toll.missedByGrid.length} crossings, circled.`}>
    <path d={trailPath} class="trail" pathLength="1" />
    {plazas.map((p) => (
      <g>
        {p.missed && <circle cx={p.x} cy={p.y} r="15" class="miss" />}
        <circle cx={p.x} cy={p.y} r="9" class="plaza" />
        <text x={p.x} y={p.y + 3.5} text-anchor="middle" class="num">{p.n}</text>
      </g>
    ))}
  </svg>

  <div class="md:col-span-2">
    <p class="mb-3 text-sm font-medium">Plaza location error, from debits alone</p>
    <ul class="grid gap-1.5 text-[0.82rem]">
      {plazas.map((p) => (
        <li class="grid grid-cols-[1.25rem_1fr_2.4rem] items-center gap-2">
          <span class="text-muted tabular-nums">{p.n}</span>
          <span class="track"><span class="fill" style={`--w:${Math.max(4, (p.errM / maxErr) * 100)}%`}></span></span>
          <span class="text-right tabular-nums text-muted">{p.errM} m</span>
        </li>
      ))}
    </ul>
    <p class="mt-4 flex items-center gap-2 text-xs text-muted">
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="9" class="miss" /></svg>
      Crossing the old grid method missed for this truck
    </p>
  </div>
</div>

<style>
  .trail { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; opacity: 0.55; }
  .plaza { fill: var(--card); stroke: var(--ink); stroke-width: 1.3; }
  .num { font: 600 10px var(--font-sans); fill: var(--ink); }
  .miss { fill: none; stroke: var(--accent-ink); stroke-width: 1.6; stroke-dasharray: 3 3; }
  .track { height: 8px; border-radius: 4px; background: color-mix(in srgb, var(--ink) 6%, transparent); overflow: hidden; display: block; }
  .fill { display: block; height: 100%; width: var(--w); background: var(--accent); border-radius: 4px; transform-origin: left; }
  :global(html.js) [data-toll-map] .trail { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.6s ease; }
  :global(html.js .is-in) [data-toll-map] .trail, :global(html.js) [data-toll-map]:global(.is-in) .trail { stroke-dashoffset: 0; }
  :global(html.js) [data-toll-map] .fill { transform: scaleX(0); transition: transform 800ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  :global(html.js .is-in) [data-toll-map] .fill, :global(html.js) [data-toll-map]:global(.is-in) .fill { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) [data-toll-map] .trail { stroke-dashoffset: 0; }
    :global(html.js) [data-toll-map] .fill { transform: none; }
  }
</style>

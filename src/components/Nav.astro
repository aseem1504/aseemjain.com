---
const links = [
  ['Work', '/#work'],
  ['Story', '/#story'],
  ['Projects', '/#projects'],
  ['Beyond work', '/#beyond'],
  ['Contact', '/#contact'],
];
---

<nav id="nav" class="sticky top-0 z-50 border-b border-transparent bg-paper/85 backdrop-blur" aria-label="Main">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="/" class="display text-2xl leading-none" aria-label="Aseem Jain, home">aj<span class="text-accent">.</span></a>

    <ul class="hidden items-center gap-7 text-[0.92rem] text-muted md:flex">
      {links.map(([label, href]) => (
        <li><a href={href} class="transition-colors hover:text-ink">{label}</a></li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <button type="button" class="theme-toggle grid h-10 w-10 place-items-center rounded-full border border-line text-ink transition-colors hover:border-ink" aria-label="Toggle dark mode" data-theme-toggle>
        <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/></svg>
      </button>
      <a href="/Aseem_Jain_CV.pdf" class="btn btn-primary no-print" download>Download CV</a>
      <button type="button" class="grid h-10 w-10 place-items-center rounded-full border border-line md:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <div id="menu" class="hidden border-t border-line bg-paper md:hidden">
    <ul class="wrap grid gap-1 py-3 text-base">
      {links.map(([label, href]) => (
        <li><a href={href} class="block rounded-lg px-2 py-2.5 hover:bg-warm" data-menu-link>{label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  :global(html[data-theme='dark']) .theme-moon { display: none; }
  :global(html:not([data-theme='dark'])) .theme-sun { display: none; }
  nav.is-scrolled { border-bottom-color: var(--line); }
</style>

---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/tiro-devanagari-hindi/400.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import sansFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
}

const {
  title = 'Aseem Jain | Product Manager',
  description = 'Aseem Jain is a product manager with 6.5+ years in payments, embedded credit, telematics and data. IIM Ahmedabad PGPX 2027.',
  path = '/',
  ogImage = '/og.png',
} = Astro.props;

const site = 'https://aseemjain.com';
const canonical = new URL(path, site).href;
const og = new URL(ogImage, site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Aseem Jain',
  url: site,
  jobTitle: 'Product Manager',
  description,
  email: 'x26aseemj@iima.ac.in',
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Indian Institute of Management Ahmedabad' },
    { '@type': 'CollegeOrUniversity', name: 'Vellore Institute of Technology' },
  ],
  sameAs: [
    'https://www.linkedin.com/in/aseemjain1504',
    'https://github.com/aseem1504',
    'https://www.instagram.com/aseemjain1504',
    'https://mbapgpxprofiles.iima.ac.in/profile/aseem-jain-1',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Aseem Jain" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#09090b" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aseem Jain" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    <script is:inline>
      document.documentElement.classList.add('js');
      document.documentElement.setAttribute('data-theme', 'dark');
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:rounded-md focus:bg-ink focus:px-3 focus:py-2 focus:text-paper">Skip to content</a>
    <div class="progress" data-progress aria-hidden="true"></div>
    <Nav />
    <main id="main">
      <slot />
    </main>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
